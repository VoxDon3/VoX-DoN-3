CACHE MANIFEST
# VoX-DoN-3 offline cache
#
# One page: index.html holds the blue Jailbreak button and the log box, and it
# runs SlopKit in a layer on top of that same page. Nothing navigates away, so
# the only documents that are ever requested are the ones listed here.
#
# Every entry must be the EXACT URL a page asks for, query string included,
# otherwise the browser skips the cache and reaches for the network - which is
# the whole reason the offline run used to fail.
#
# r5: single-page host. index.html hosts the chain, so progress.html is no
# longer on the path. kstuff.elf and nanodns.elf were removed from the menu and
# from this cache. Payload Manager (pldmgr_v0.5.2.elf) is first in the menu and
# is the one the host taps for the user when the chain finishes.
# Firmware support is 9.00-12.00, which is exactly the offsets/ list below.
#
# غيّر رقم الإصدار بعد أي تعديل على الملفات
# version: 2026-10-02-single-page-r5

CACHE:
index.html
progress.html
main.css
cache-status.js
vox-pl-inject.js
voxbackground.jpg

slopkit/poops.html?go=1&auto=1&production=1&trigger=netcontrol&attempts=8&only=ps0_preflight,ps1_prepare,ps3_stage0,ps4_validate,ps5_stage1,ps6_stage2,ps8_stage3,ps9_stage4,ps10_stage5&log=debug&payload=1&v=final
slopkit/poops.html
slopkit/poops.js?v=final
slopkit/core.js?v=final
slopkit/int64.js
slopkit/main.js?v=final
slopkit/mem.js?v=final
slopkit/rop.js?v=final
slopkit/rop_slave.js?v=final
slopkit/syscalls.js

offsets/9.00.js?v=final
offsets/9.05.js?v=final
offsets/9.20.js?v=final
offsets/9.40.js?v=final
offsets/9.60.js?v=final
offsets/10.00.js?v=final
offsets/10.01.js?v=final
offsets/10.20.js?v=final
offsets/10.40.js?v=final
offsets/10.60.js?v=final
offsets/11.00.js?v=final
offsets/11.20.js?v=final
offsets/11.40.js?v=final
offsets/11.60.js?v=final
offsets/12.00.js?v=final

payloads/kexp_2026_05_25.bin
payloads/elfldr-ps5-1360.elf
payloads/pldmgr_v0.5.2.elf
payloads/PLK.elf
payloads/ftpsrv-ps5.elf
